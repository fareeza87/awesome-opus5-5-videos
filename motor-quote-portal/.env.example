# Copy this file to .env and fill it in. Never commit .env or send it to anyone.

# Port the portal runs on. 5000 = same as the old bot server, so your ngrok command keeps working.
PORT=5000

# Password staff type to open the portal (required when phones on the Wi-Fi use it)
PORTAL_PASSWORD=

# Which real insurers to quote (comma separated): po, allianz, ikhlas
INSURERS=po

# Also show the demo insurers (sample prices). Keep 0 when testing for real.
DEMO_INSURERS=0

# Show the bot's browser so you can watch it (1) or hide it (0)
RPA_HEADED=1

# Pacific & Orient
PO_PORTAL_USER=
PO_PORTAL_PASS=

# Allianz (give the bot its own login: it logs out other sessions on the same login)
ALLIANZ_PORTAL_USER=
ALLIANZ_PORTAL_PASS=
ALLIANZ_PORTAL_SECRET=
ALLIANZ_FALLBACK_EMAIL=

# Takaful Ikhlas
IKHLAS_PORTAL_USER=
IKHLAS_PORTAL_PASS=

# Agency details printed on the quotation
AGENCY_NAME=
AGENCY_CONTACT=
AGENCY_EMAIL=

# Encrypts portal passwords the bots change themselves. Any long random text; keep a copy safe.
VAULT_KEY=
